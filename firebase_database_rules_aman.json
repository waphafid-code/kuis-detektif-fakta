{
  "rules": {
    "quiz_results": {
      ".read": true,
      ".indexOn": ["student_name"],
      "$key": {
        ".write": true,
        ".validate": "newData.hasChildren(['student_name','student_class','score']) && newData.child('score').isNumber() && newData.child('score').val() >= 0 && newData.child('score').val() <= 100"
      }
    },
    "submissions_log": {
      ".read": true,
      "$id": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['student_name','student_class','score','rtdb_key','integrity']) && newData.child('score').isNumber() && newData.child('score').val() >= 0 && newData.child('score').val() <= 100"
      }
    },
    "deleted_archive": {
      ".read": true,
      "$id": {
        ".write": "!data.exists()"
      }
    }
  }
}
